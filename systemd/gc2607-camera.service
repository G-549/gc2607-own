[Unit]
Description=GC2607 camera pipeline (raw -> YUYV on /dev/video60)
Documentation=https://github.com/G-549/gc2607-own
After=systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe v4l2loopback
ExecStartPre=/bin/sh -c 'for i in $(seq 1 20); do [ -c /dev/video60 ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/gc2607d -o /dev/video60
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
